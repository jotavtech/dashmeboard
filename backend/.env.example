NODE_ENV=development
BACKEND_PORT=4000
DATABASE_URL=postgresql://dashme:dashme_local_password@localhost:5432/dashmeboard?schema=public
# Tests are destructive (they wipe users/projects) — always point them at the
# disposable test database, never the dev one:
TEST_DATABASE_URL=postgresql://dashme:dashme_local_password@localhost:5432/dashmeboard_test?schema=public
CORS_ORIGIN=http://localhost:5173

# Auth (ADR-001). Required in production; dev/test fall back to a per-process
# random secret. Generate one with: openssl rand -hex 32
JWT_SECRET=

# OpenAI — backend only. Never expose this to the frontend.
# Optional: the API boots without it; AI routes return 503 until it is set.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
