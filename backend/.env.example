NODE_ENV=development
BACKEND_PORT=4000
DATABASE_URL=postgresql://dashme:dashme_local_password@localhost:5432/dashmeboard?schema=public
# Tests are destructive and refuse to run against non-local hosts.
# CI (or anyone opting in) can point them at a disposable database:
# TEST_DATABASE_URL=
CORS_ORIGIN=http://localhost:5173

# OpenAI — backend only. Never expose this to the frontend.
# Optional: the API boots without it; AI routes return 503 until it is set.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
